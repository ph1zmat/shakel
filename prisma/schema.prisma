// ========================================
// VISUAL BUILDER PLATFORM v2.0
// ========================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ========================================
// CORE: User & Auth (без изменений)
// ========================================

model User {
  id            String       @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  workflows     Workflow[]
  projects      Project[] // Заменили webProjects + bots
  credentials   Credential[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Credential {
  id        String         @id @default(cuid())
  name      String
  value     String
  type      CredentialType
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  Node   Node[]

  @@map("credential")
}

enum CredentialType {
  OPENAI
  ANTHROPIC
  GEMINI
  DEEPSEEK
  MISTRAL
  OLLAMA

  @@map("credential_type")
}

// ========================================
// CORE: Workflows (расширенная версия)
// ========================================

model Workflow {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  nodes       Node[]
  connections Connection[]
  executions  Execution[]

  // Связь с проектом (опциональная)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Interactions которые триггерят этот workflow
  interactions Interaction[]

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("workflow")
}

enum NodeType {
  INITIAL
  MANUAL_TRIGGER
  HTTP_REQUEST
  GOOGLE_FORM_TRIGGER
  STRIPE_TRIGGER
  ANTHROPIC
  GEMINI
  DEEPSEEK
  MISTRAL
  OLLAMA
  OPENAI
  DISCORD
  SLACK

  @@map("node_type")
}

model Node {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  name     String
  type     NodeType
  position Json
  data     Json     @default("{}")

  credentialId String?
  credential   Credential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  outputConnections Connection[] @relation("FromNode")
  inputConnections  Connection[] @relation("ToNode")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("node")
}

model Connection {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  fromNodeId String
  fromNode   Node   @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId   String
  toNode     Node   @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)
  fromOutput String @default("main")
  toInput    String @default("main")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fromNodeId, toNodeId, fromOutput, toInput])
  @@map("connection")
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  FAILED

  @@map("execution_status")
}

model Execution {
  id String @id @default(cuid())

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  status     ExecutionStatus @default(RUNNING)
  error      String?         @db.Text
  errorStack String?         @db.Text

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  inngestEventId String @unique()

  output Json?

  @@map("execution")
}

// ========================================
// Design System (гибкая темизация)
// ========================================

model DesignSystem {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Tokens
  colors     ColorToken[]
  spacing    SpacingToken[]
  typography TypographyToken[]
  effects    EffectToken[]

  // Связанные проекты
  projects Project[]

  @@map("design_system")
}

model ColorToken {
  id   String @id @default(cuid())
  name String // "primary", "background", "danger"

  // HSL representation для гибкости
  hue        Int   @default(0) // 0-360
  saturation Int   @default(0) // 0-100
  lightness  Int   @default(0) // 0-100
  alpha      Float @default(1) // 0-1

  // Semantic mapping
  isSemantic   Boolean @default(false)
  semanticRole String? // "background", "foreground", "accent", "muted"

  designSystemId String
  designSystem   DesignSystem @relation(fields: [designSystemId], references: [id], onDelete: Cascade)

  @@unique([designSystemId, name])
  @@map("color_token")
}

model SpacingToken {
  id    String @id @default(cuid())
  name  String // "xs", "sm", "md", "lg", "xl"
  value Float // rem (0.25, 0.5, 1, 1.5, 2)

  designSystemId String
  designSystem   DesignSystem @relation(fields: [designSystemId], references: [id], onDelete: Cascade)

  @@unique([designSystemId, name])
  @@map("spacing_token")
}

model TypographyToken {
  id   String @id @default(cuid())
  name String // "heading", "body", "mono"

  family   String
  weights  Int[] // [400, 500, 700]
  fallback String @default("system-ui, sans-serif")

  // Fluid typography
  minSize    Float // rem
  maxSize    Float // rem
  lineHeight Float

  designSystemId String
  designSystem   DesignSystem @relation(fields: [designSystemId], references: [id], onDelete: Cascade)

  @@unique([designSystemId, name])
  @@map("typography_token")
}

model EffectToken {
  id     String     @id @default(cuid())
  name   String // "shadow-sm", "glow-primary"
  type   EffectType
  params Json // { x: 0, y: 4, blur: 12, color: "hsla(...)" }

  designSystemId String
  designSystem   DesignSystem @relation(fields: [designSystemId], references: [id], onDelete: Cascade)

  @@unique([designSystemId, name])
  @@map("effect_token")
}

enum EffectType {
  SHADOW
  BLUR
  GLOW
  BORDER

  @@map("effect_type")
}

// ========================================
// Projects (унификация Web + Bot)
// ========================================

enum Platform {
  WEB
  TELEGRAM_BOT
  MOBILE_APP

  @@map("platform")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("publish_status")
}

model Project {
  id        String        @id @default(cuid())
  name      String
  platform  Platform
  status    PublishStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Design
  designSystemId String
  designSystem   DesignSystem @relation(fields: [designSystemId], references: [id])

  // Structure
  pages     Page[]
  workflows Workflow[]

  // Code Generation
  codeArtifacts CodeArtifact[]

  // Platform-specific config
  webConfig WebProjectConfig?
  botConfig BotProjectConfig?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("project")
}

// Platform-specific configs
model WebProjectConfig {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  domain         String?
  seoTitle       String?
  seoDescription String? @db.Text
  favicon        String?

  // Next.js specific
  basePath String @default("/")

  @@map("web_project_config")
}

model BotProjectConfig {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Telegram Bot API
  token      String? @unique
  webhookUrl String?

  // Bot behavior
  parseMode             String  @default("HTML") // HTML, MarkdownV2
  disableWebPagePreview Boolean @default(false)

  @@map("bot_project_config")
}

// ========================================
// Pages (структура сайта/бота)
// ========================================

enum ViewportMode {
  DESKTOP
  TABLET
  MOBILE
  BOT_CHAT

  @@map("viewport_mode")
}

model Page {
  id      String  @id @default(cuid())
  name    String // "Home", "About", "Start"
  slug    String // "/", "about", "start"
  isEntry Boolean @default(false) // Entry point
  order   Int     @default(0) // Для сортировки

  // Canvas настройки
  viewport   ViewportMode @default(DESKTOP)
  background Json? // { type: "color"|"gradient"|"image", value: "..." }

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Component Tree
  nodes ComponentNode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, slug])
  @@map("page")
}

// ========================================
// Component Tree (Visual Builder Core)
// ========================================

model ComponentNode {
  id String @id @default(cuid())

  // Hierarchy (Adjacency List)
  parentId String?
  parent   ComponentNode?  @relation("NodeChildren", fields: [parentId], references: [id])
  children ComponentNode[] @relation("NodeChildren")

  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  // Component Definition
  type    String @default("container") // "button", "text", "container", "image"
  library String @default("built-in") // "built-in", "shadcn", "custom"

  // Properties (JSON Schema based)
  props  Json @default("{}") // { text: "Click me", variant: "solid" }
  styles Json @default("{}") // { base: { padding: {...} }, hover: {...} }

  // Ordering для drag-drop
  order Int @default(0)

  // Interactions (события)
  interactions Interaction[]

  // Style bindings (ссылки на Design Tokens)
  styleBindings StyleBinding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, parentId, order])
  @@map("component_node")
}

model StyleBinding {
  id String @id @default(cuid())

  nodeId String
  node   ComponentNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  property   String // "backgroundColor", "fontSize", "padding"
  tokenType  TokenType
  tokenName  String // "primary", "md", "heading"
  isVariable Boolean   @default(true) // true = CSS var, false = static

  @@unique([nodeId, property])
  @@map("style_binding")
}

enum TokenType {
  COLOR
  SPACING
  TYPOGRAPHY
  EFFECT
  CUSTOM

  @@map("token_type")
}

// ========================================
// Interactions (автоматизации + логика)
// ========================================

enum InteractionType {
  // Базовая логика (client-side)
  NAVIGATE
  OPEN_MODAL
  CLOSE_MODAL
  SCROLL_TO
  SHOW_FORM
  HIDE_FORM
  SET_STATE
  TOGGLE_VISIBILITY

  // Workflow автоматизации
  TRIGGER_WORKFLOW

  // Bot-specific
  SEND_MESSAGE
  EDIT_MESSAGE
  SHOW_KEYBOARD
  HIDE_KEYBOARD

  @@map("interaction_type")
}

model Interaction {
  id String @id @default(cuid())

  nodeId String
  node   ComponentNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  // Trigger: onClick, onSubmit, onHover, onMount, onMessage (bot)
  trigger String @default("onClick")

  type InteractionType

  // Конфигурация действия (type-specific)
  config Json @default("{}")
  // NAVIGATE: { url: "/about", newTab: false }
  // TRIGGER_WORKFLOW: { workflowId: "...", inputMapping: {...} }
  // SEND_MESSAGE: { text: "Hello {{user.name}}" }

  // Привязка к Workflow
  workflowId String?
  workflow   Workflow? @relation(fields: [workflowId], references: [id])

  // Execution
  debounceMs  Int     @default(0)
  showLoading Boolean @default(false)
  condition   String? // JS expression для conditional execution

  order Int @default(0) // Priority для chained actions

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nodeId, trigger])
  @@map("interaction")
}

// ========================================
// Code Artifacts (генерированный код)
// ========================================

enum ArtifactType {
  NEXTJS_PAGE
  NEXTJS_LAYOUT
  NEXTJS_COMPONENT
  REACT_COMPONENT
  CSS_STYLESHEET
  TAILWIND_CONFIG
  NESTJS_HANDLER
  NESTJS_MODULE
  NESTJS_SERVICE
  PACKAGE_JSON
  DOCKERFILE

  @@map("artifact_type")
}

model CodeArtifact {
  id       String       @id @default(cuid())
  type     ArtifactType
  filePath String // "app/page.tsx", "src/bot/handlers/start.ts"
  content  String       @db.Text

  // Для incremental builds
  contentHash String
  dependsOn   String[] // ["design-system", "page:home"]

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  generatedAt DateTime @default(now())

  @@unique([projectId, filePath])
  @@map("code_artifact")
}
